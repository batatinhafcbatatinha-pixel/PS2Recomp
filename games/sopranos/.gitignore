# Public repository: only hand-written source, scripts, configuration and notes.
# Never published: disc images, game files, executables, recompiled/generated code,
# disassembly, Ghidra projects, dumps, captures, saves, logs and builds.
/*
!/.gitignore
!/.gitmodules
!/*.md
!/*.cmd
!/*.ps1
!/*.sh
!/installer.json
!/scripts/
!/config/
!/project/

**/__pycache__/
*.pyc
*.log
*.csv
*.bin
*.elf
*.iso
*.chd
*.irx
*.img
*.xbe
*.xex
*.exe
*.dll
*.lib
*.obj
*.pdb
*.pgm
*.png
*.ps2
config/output/
config/ghidra*.toml
project/out/
project/generated/
project/runner/
project/runner-chunks/
project/runner-labels-partial/
project/gap-functions/
project/gap-functions.*
project/sdk-handlers.inc
project/recovered/
project/kernel-handlers/
project/supplemental*/
project/iop_aot/
project/vu1n/
**/recomp/gen/

# Local game data and installer outputs
game_files/
.game-install.lock
game-install-report.json

# Shared PS2Recomp runtime (fork, submodule) and the shared game-data installer (submodule)
!/third_party/
!/third_party/PS2Recomp
!/tools/
!/tools/port-installer

# Notes for AI agents and the local build location stay local
/CONTINUACAO.md
/TASK*.md
/ASK*.md
/claude-test.cmd
/build-location.txt

# One-click setup (Setup.cmd): shared scripts, this game's steps, and its log
!/setup.json
!/requirements.txt
!/tools/
!/tools/setup.ps1
!/tools/setup_tools.py
setup-log.txt

# Launcher (installer, Play, Dependencies, PC settings): its source and this game's configuration
!/launcher.json
!/tools/launcher/
/tools/launcher/bin/
/tools/launcher/obj/
!/.github/
!/port.toml
!/handlers.cpp

# Hand-written PCSX2-format patches (pnach) for this game
!/patches/
