{
  "game": "Grand Theft Auto: Vice City Stories",
  "disc": "PlayStation 2, USA (SLUS-21590)",
  "play": "Play.cmd",
  "disk_gb": 20,
  "download_gb": 1,
  "minutes": "60-180",
  "tools": [
    "llvm-mingw",
    "cmake",
    "ninja",
    "ghidra"
  ],
  "gb_per_job": 2,
  "steps": [
    {
      "name": "Analyse your game executable (Ghidra) and translate the game (PS2Recomp)",
      "run": [
        "{python}",
        "../../tools/ps2port/ps2port.py",
        "prepare",
        "--port",
        "{root}"
      ],
      "done_if": "build/chunks/chunk_register.cpp",
      "prepare": true
    },
    {
      "name": "Compile",
      "run": [
        "{python}",
        "../../tools/ps2port/ps2port.py",
        "compile",
        "--port",
        "{root}"
      ],
      "retry_if": "build/native/build.ninja"
    }
  ],
  "buildtools": false
}
