{
  "game": "Gran Turismo 4",
  "disc": "PlayStation 2, USA v2.00 (SCUS-97328)",
  "play": "Play-GT4.cmd",
  "disk_gb": 25,
  "download_gb": 1,
  "minutes": "90-240",
  "tools": [
    "cmake",
    "ninja",
    "ghidra"
  ],
  "gb_per_job": 4,
  "steps": [
    {
      "name": "Decode the game executable (CORE.GT4)",
      "run": [
        "{python}",
        "scripts/build_core_elf.py"
      ],
      "done_if": "game_files/CORE.ELF",
      "prepare": true
    },
    {
      "name": "Find the functions of your game executable (Ghidra, can take an hour)",
      "run": [
        "cmd",
        "/c",
        "ghidra-export-core.cmd"
      ],
      "done_if": "config/ghidra-core-functions-only.csv",
      "prepare": true
    },
    {
      "name": "Build the PS2Recomp tools",
      "run": [
        "cmd",
        "/c",
        "build-recompiler.cmd"
      ],
      "done_if": "recompiler/ps2xRecomp/ps2_recomp.exe",
      "prepare": true
    },
    {
      "name": "Translate the game code",
      "run": [
        "{python}",
        "scripts/prepare_game_code.py"
      ],
      "done_if": "project/sdk-handlers.inc",
      "prepare": true
    },
    {
      "name": "Compile",
      "run": [
        "cmd",
        "/c",
        "build-native.cmd",
        "--jobs",
        "{jobs}"
      ],
      "retry_if": "build/native/build.ninja"
    }
  ]
}
